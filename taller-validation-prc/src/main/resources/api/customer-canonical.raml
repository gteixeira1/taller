#%RAML 1.0 DataType

type: object
properties:
  customerId:
    type: string
  externalId:
    type: string | nil
  firstName:
    type: string
  lastName:
    type: string
  fullName:
    type: string
  email:
    type: string
  dateOfBirth:
    type: date-only
  age:
    type: number | nil
  address:
    type: object
    properties:
      street:
        type: string | nil
      city:
        type: string | nil
      state:
        type: string | nil
      postalCode:
        type: string | nil
      country:
        type: string | nil
  sourceMeta:
    type: object
    properties:
      sourceSystem:
        type: string| nil
      receivedAt:
        type: datetime